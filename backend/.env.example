# SQL Server connection (the Docker container from docker-compose.yml)
DB_SERVER=localhost,1433
DB_NAME=TeamDesk
# Least-privilege login created by sql/05_app_user.sql (password = APP_DB_PASSWORD in the root .env)
DB_USER=teamdesk_app
DB_PASSWORD=TeamDesk#App2026
DB_DRIVER=ODBC Driver 18 for SQL Server
# Local Docker uses a self-signed certificate; set to "no" with a real certificate.
DB_TRUST_SERVER_CERTIFICATE=yes

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5175
